ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...   # optional, not used by default

# Paths (defaults work if running from project root)
DATA_DIR=./data
CORPUS_DIR=./corpus

# Budget mode: low | medium | high
BUDGET_MODE=medium

# Semantic Scholar API key (optional — higher rate limits with key)
SEMANTIC_SCHOLAR_API_KEY=
